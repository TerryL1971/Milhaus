# .env.example
# Copy to .env.local and fill in with real values from the Supabase project
# dashboard (Settings > API). Never commit .env.local or real keys.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser; access is
# constrained by Postgres Row Level Security policies on each table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, bypasses Row Level Security.
# Used for admin/server-side operations (e.g. the admin dashboard's
# moderation actions). Never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The site's real public URL, no trailing slash (e.g. https://milhaus.com).
# Used to build the sitemap, canonical URLs, and Open Graph tags. Leave
# unset locally — falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# From Google Search Console (Settings > Ownership verification > HTML tag
# — copy just the "content" value, not the whole tag) once the site has a
# real domain to verify. Leave blank until then; the meta tag just won't
# render.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sentry error tracking. DSN from Sentry -> Project Settings -> Client
# Keys (DSN) for the milhaus project. Safe to expose to the browser —
# that's what a DSN is for.
NEXT_PUBLIC_SENTRY_DSN=

# Optional — only needed to upload source maps (readable stack traces in
# Sentry instead of minified code). Leave unset otherwise; the build just
# skips that step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe — dealer posting checkout (see supabase/migrations/
# 20260928120100_listing_prices_and_payments.sql). Use pk_test_.../
# sk_test_... from the Stripe Dashboard (Developers > API keys) while in
# test mode; swap for pk_live_.../sk_live_... only once real payments are
# ready to go live. Publishable key is safe to expose to the browser; the
# secret key is server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# PayPal — same purpose as the Stripe keys above. From
# developer.paypal.com > Apps & Credentials; use the Sandbox app's
# credentials for test mode, the Live app's once ready to charge real
# money. Client ID is safe to expose to the browser (PayPal's JS SDK
# needs it there); the secret is server-only.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Resend — sends the payment-receipt/invoice email after a cart checkout
# settles (src/lib/email.ts, src/lib/invoice-email.ts). This is a
# separate concern from the Resend SMTP setup for Supabase's own auth
# emails described in supabase/SETUP.md; this key is used directly by
# the app's own code, server-only. Get an API key from
# resend.com > API Keys. Until both vars below are set, settlement still
# happens normally — the invoice email is just skipped, with a console
# warning.
RESEND_API_KEY=

# Sender address for the invoice email, e.g. "Milhaus <receipts@milhaus.com>".
# Must be on a domain verified with Resend (resend.com > Domains) —
# Resend will reject sends from an unverified domain, and a plain
# onboarding@resend.dev sender only delivers to your own Resend account
# email, not real customers.
EMAIL_FROM=
